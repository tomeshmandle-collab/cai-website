---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent, getTeamContent } from '../lib/content';
import { fillTemplate } from '../lib/counts';
import ArtLayer from '../components/ArtLayer.astro';
import Stepper from '../components/Stepper.astro';
import ArcGraphic from '../components/team/ArcGraphic.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import FunctionCard from '../components/team/FunctionCard.astro';
import MemberGroup from '../components/team/MemberGroup.astro';
import { getImage } from 'astro:assets';

// Artwork imports - Team Hero
import imgGlow4 from '../assets/art/10_glow_4.webp';
import imgGradBlueDark from '../assets/art/11a_gradient_blue_dark.webp';

const site = await getSiteContent();
const team = await getTeamContent();

// Dynamic subline: "Fifteen people, eight functions, one centre — meet the operating body running CAI this year."
const subline = await fillTemplate(team.hero.sublineTemplate);

// Optimize hero ambient artwork
const optGlow4 = await getImage({ src: imgGlow4, width: 400 });
const optGradBlueDark = await getImage({ src: imgGradBlueDark, width: 800 });
---

<BaseLayout 
  title={`Team | ${site.seo.siteTitle}`} 
  description={site.seo.defaultDescription}
  transparentHeader={true}
>
  <!-- Hero Section -->
  <section class="hero team-hero">
    <!-- Ambient Art Layers -->
    <div class="hero-art" aria-hidden="true">
      <ArtLayer 
        srcDesktop={optGradBlueDark.src} 
        positionDesktop="center"
        sizeDesktop="70%"
        opacity={0.16}
        blendMode="screen"
        class="team-art-backdrop"
      />
      <ArtLayer 
        srcDesktop={optGlow4.src} 
        positionDesktop="center left"
        positionMobile="top left"
        sizeDesktop="40%"
        sizeMobile="60%"
        blendMode="screen"
        opacity={0.25}
        drift="slow"
        class="team-glow-left"
      />
      <ArtLayer 
        srcDesktop={optGlow4.src} 
        positionDesktop="center right"
        positionMobile="bottom right"
        sizeDesktop="45%"
        sizeMobile="65%"
        blendMode="screen"
        opacity={0.3}
        drift="slow"
        class="team-glow-right"
      />
    </div>

    <!-- Hero Content Container -->
    <div class="hero-content team-hero-content">
      <!-- Top Left Corner Text (Desktop) -->
      <div class="corner-text top-left desktop-only reveal">
        <div class="bar" aria-hidden="true"></div>
        <p>
          {team.hero.cornerTopLeft[0]}<br />
          {team.hero.cornerTopLeft[1]}<br />
          {team.hero.cornerTopLeft[2]}<br />
          {team.hero.cornerTopLeft[3]}
        </p>
      </div>

      <!-- Main Hero Grid (Copy Left, Arc Right) -->
      <div class="team-hero-grid">
        <!-- Left Column: Copy & Action -->
        <div class="team-hero-left reveal">
          <!-- Pill: ● OUR PEOPLE ● -->
          <div class="team-hero-pill">
            <span class="pill-dot" aria-hidden="true">●</span>
            <span class="pill-text">{team.hero.pill}</span>
            <span class="pill-dot" aria-hidden="true">●</span>
          </div>

          <!-- Three-line Serif Heading -->
          <h1 class="team-hero-heading">
            <span class="heading-line">{team.hero.headingLine1}</span>
            <span class="heading-line">{team.hero.headingLine2}</span>
            <em class="heading-line accent">{team.hero.headingAccent}</em>
          </h1>

          <!-- Computed Subline -->
          <p class="subline team-hero-subline">{subline}</p>

          <!-- Primary CTA Button -->
          <div class="team-hero-cta">
            <a href={team.hero.cta.href} class="btn-primary">
              <span>{team.hero.cta.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Inline SVG Arc Graphic -->
        <div class="team-hero-right reveal">
          <ArcGraphic words={team.hero.arcWords} />
        </div>
      </div>
    </div>
  </section>

  <!-- Page Body with Stepper and Section Placeholders -->
  <div class="page-body">
    <!-- Desktop Stepper Column (Sticky 3-step rail) -->
    <aside class="stepper-column desktop-only" aria-label="Team page navigation">
      <div class="stepper-sticky">
        <Stepper steps={team.stepper} />
      </div>
    </aside>

    <!-- Sections Area -->
    <main class="sections">
      <!-- Section 01: Our Structure (Phase 3B) -->
      <section id="our-structure" class="page-section section-our-structure">
        <div class="mobile-only section-stepper">
          <Stepper steps={team.stepper} activeId="our-structure" />
        </div>
        <div class="section-content reveal">
          <div class="section-header-split">
            <div class="header-left">
              <Eyebrow text={await fillTemplate(team.structure.eyebrowTemplate)} color="magenta" />
              <h2 class="team-section-title">{team.structure.heading}</h2>
            </div>
            <div class="header-right">
              <p class="section-intro">{team.structure.intro}</p>
            </div>
          </div>
          
          <div class="function-grid">
            {team.functions.map((func: any) => (
              <FunctionCard
                icon={func.icon}
                title={func.name}
                description={func.description}
                href={func.link}
              />
            ))}
          </div>
        </div>
      </section>

      <!-- Section 02: The Team (Phase 3B) -->
      <section id="the-team" class="page-section section-the-team">
        <div class="mobile-only section-stepper">
          <Stepper steps={team.stepper} activeId="the-team" />
        </div>
        <div class="section-content reveal">
          <div class="section-header-split">
            <div class="header-left">
              <Eyebrow text={await fillTemplate(team.theTeam.eyebrowTemplate)} color="magenta" />
              <h2 class="team-section-title">{team.theTeam.heading}</h2>
            </div>
            <div class="header-right">
              <p class="section-intro">{await fillTemplate(team.theTeam.introTemplate)}</p>
            </div>
          </div>
          
          <div class="member-groups">
            {team.theTeam.groups.map((group: any) => (
              <MemberGroup groupId={group.id} />
            ))}
          </div>
        </div>
      </section>

    </main>
  </div>
</BaseLayout>

<script>
  import { initStepper } from '../lib/stepper';
  import { initReveal } from '../lib/reveal';
  import { initCarousel } from '../lib/carousel';

  // Initialize scripts on the client
  document.addEventListener('DOMContentLoaded', () => {
    initStepper();
    initReveal();
    initCarousel();
  });
</script>

<style>
  /* Team Hero Styles */
  .hero.team-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    min-height: max(640px, 100vh);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .team-glow-left {
    transform: translate(-10%, 0);
  }

  .team-glow-right {
    transform: translate(10%, 10%);
  }

  .team-hero-content {
    position: relative;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 100px var(--container-px) 60px;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 10;
  }

  /* Team Hero Grid */
  .team-hero-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    align-items: center;
    width: 100%;
    margin-top: var(--space-4);
  }

  .team-hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 100%;
  }

  /* Pill: ● OUR PEOPLE ● */
  .team-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(224, 64, 216, 0.45);
    background: rgba(224, 64, 216, 0.06);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-5);
  }

  .pill-dot {
    color: var(--color-magenta);
    font-size: 7px;
  }

  .pill-text {
    font-weight: 500;
  }

  /* Heading: The team behind / Centre for / Artificial Intelligence */
  .team-hero-heading {
    font-family: var(--font-serif);
    font-size: var(--text-h2-serif);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 var(--space-5) 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .heading-line {
    display: block;
  }

  .heading-line.accent {
    font-style: italic;
    color: var(--color-magenta);
  }

  /* Subline */
  .team-hero-subline {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 480px;
  }

  /* Primary Button */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-button-bg);
    color: var(--color-button-text);
    padding: 0 22px;
    height: 48px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--shadow-button);
    transition: all var(--ease);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(255,255,255,0.2);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-primary:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .arrow {
    transition: transform var(--ease);
  }

  .btn-primary:hover .arrow {
    transform: translateX(3px);
  }

  /* Right column: Arc Graphic */
  .team-hero-right {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Corner Text */
  .corner-text {
    position: absolute;
    font-size: var(--text-corner);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    display: flex;
    gap: 16px;
    line-height: 1.5;
    max-width: calc(100% - 48px);
  }

  .corner-text p {
    margin: 0;
  }

  .bar {
    width: 1px;
    background: var(--color-text-faint);
  }

  .top-left {
    top: max(120px, 15vh);
    left: var(--container-px);
  }

  /* Layout below hero */
  .page-body {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-px);
    display: flex;
    gap: 64px;
  }

  .stepper-column {
    width: 200px;
    flex-shrink: 0;
    padding-top: 100px;
  }

  .stepper-sticky {
    position: sticky;
    top: 120px; /* Offset from header */
  }

  .sections {
    flex: 1;
    min-width: 0;
    padding-top: 40px;
    padding-bottom: 120px;
  }

  .page-section {
    position: relative;
    min-height: 50vh;
    padding: 60px 0 80px;
  }

  .section-placeholder {
    min-height: 200px;
  }

  .section-stepper {
    margin-bottom: 40px;
  }

  .desktop-only {
    display: none;
  }

  /* Tablet Range (740px to 1023px) */
  @media (min-width: 740px) and (max-width: 1023px) {
    .team-hero-content {
      padding: 120px 40px 80px;
    }

    .page-body {
      padding: 0 40px;
    }

    .team-hero-left {
      max-width: 580px;
      align-items: center;
      text-align: center;
    }

    .team-hero-heading {
      align-items: center;
    }

    .team-hero-subline {
      text-align: center;
    }

    .page-section {
      padding: 80px 0 100px;
    }
  }

  /* Desktop (≥1024px) */
  @media (min-width: 1024px) {
    .desktop-only {
      display: flex;
    }

    aside.desktop-only {
      display: block;
    }

    .mobile-only {
      display: none !important;
    }

    .team-hero-content {
      padding: 0 64px;
    }

    .top-left {
      top: 100px;
      left: 64px;
    }

    .page-body {
      padding: 0 64px;
    }

    .team-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
      margin-top: 60px;
    }

    .team-hero-left {
      max-width: 520px;
    }

    .team-hero-heading {
      font-size: clamp(38px, 4.2vw, 56px);
    }

    .team-hero-right {
      justify-content: flex-end;
    }

    .page-section {
      padding: 120px 0 140px;
      min-height: 60vh;
    }

    .section-header-split {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-8);
    }

    .header-left {
      flex: 1;
      max-width: 480px;
    }

    .header-right {
      flex: 1;
      max-width: 380px;
      margin-top: 40px;
    }

    .function-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  /* Section Common Styles */
  .section-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-header-split {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .team-section-title {
    font-family: var(--font-serif);
    font-size: var(--text-h2-serif);
    font-weight: 400;
    color: var(--color-text);
    margin: 0;
  }

  .section-intro {
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .function-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .member-groups {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .function-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
</style>
