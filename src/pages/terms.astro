---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageByRoute } from '../lib/pages';

const page = await getPageByRoute('/terms');
---

<BaseLayout title={page?.title ?? 'Terms of Use'} noindex={true}>
  <h1 class="visually-hidden">{page?.title ?? 'Terms of Use'}</h1>
</BaseLayout>
