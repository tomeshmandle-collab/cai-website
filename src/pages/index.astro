---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent, getHomeContent } from '../lib/content';
import ArtLayer from '../components/ArtLayer.astro';
import Stepper from '../components/Stepper.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import TextLink from '../components/ui/TextLink.astro';
import Icon from '../components/ui/Icon.astro';
import { getImage } from 'astro:assets';

// Artwork imports - Hero
import imgHeroDesktop from '../assets/art/02_hero_background.webp';
import imgHeroMobile from '../assets/art/01a_background_top.webp';
import imgWave1 from '../assets/art/09_wave_1.webp';
import imgGlow3 from '../assets/art/10_glow_3.webp';
import imgGlow4 from '../assets/art/10_glow_4.webp';
import imgCube1 from '../assets/art/07_cube_small_1.webp';
import imgCube2 from '../assets/art/07_cube_small_2.webp';
import imgCube3 from '../assets/art/07_cube_small_3.webp';
import imgGradBlueDark from '../assets/art/11a_gradient_blue_dark.webp';

// Artwork imports - Section 01 (Who we are)
import imgBgMiddle from '../assets/art/01b_background_middle.webp';
import imgGradBlueTop from '../assets/art/11d_gradient_blue_top.webp';

// Artwork imports - Section 03 (Our projects)
import imgCubeLarge from '../assets/art/05_cube_large.webp';
import imgWave3 from '../assets/art/09_wave_3.webp';

// Artwork imports - Section 04 (Ways to engage)
import imgGroundElement from '../assets/art/04_ground_element.webp';
import imgWave4 from '../assets/art/09_wave_4.webp';

const site = await getSiteContent();
const homeData = await getHomeContent();
const { hero, stepper, whoWeAre, whatWeDo, projects, waysToEngage } = homeData;

// Optimize images for hero
const optHeroDesktop = await getImage({ src: imgHeroDesktop, width: 2032 });
const optHeroMobile = await getImage({ src: imgHeroMobile, width: 1000 });
const optWave1 = await getImage({ src: imgWave1, width: 1200 });
const optGlow3 = await getImage({ src: imgGlow3, width: 300 });
const optGlow4 = await getImage({ src: imgGlow4, width: 300 });
const optCube1 = await getImage({ src: imgCube1, width: 300 });
const optCube2 = await getImage({ src: imgCube2, width: 300 });
const optCube3 = await getImage({ src: imgCube3, width: 300 });
const optGradBlueDark = await getImage({ src: imgGradBlueDark, width: 568 });

// Optimize images for Section 01
const optBgMiddle = await getImage({ src: imgBgMiddle, width: 1200 });
const optGradBlueTop = await getImage({ src: imgGradBlueTop, width: 600 });

// Optimize images for Section 03
const optCubeLarge = await getImage({ src: imgCubeLarge, width: 786 });
const optWave3 = await getImage({ src: imgWave3, width: 1200 });

// Optimize images for Section 04
const optGroundElement = await getImage({ src: imgGroundElement, width: 1747 });
const optWave4 = await getImage({ src: imgWave4, width: 1000 });
---

<BaseLayout title={site.seo.siteTitle} description={site.seo.defaultDescription}>
  <!-- Hero Section -->
  <section class="hero">
    <!-- Art Layers -->
    <div class="hero-art">
      <ArtLayer 
        srcDesktop={optGradBlueDark.src} 
        positionDesktop="top right"
        sizeDesktop="80%"
        opacity={0.3}
        class="desktop-only"
      />
      <ArtLayer 
        srcDesktop={optHeroDesktop.src} 
        srcMobile={optHeroMobile.src}
        positionDesktop="bottom center"
        sizeDesktop="cover"
        positionMobile="bottom center"
        sizeMobile="cover"
        mask="linear-gradient(to bottom, transparent, black 15%, black 90%, transparent)"
      />
      <ArtLayer 
        srcDesktop={optWave1.src} 
        positionDesktop="bottom left"
        sizeDesktop="100%"
        blendMode="screen"
        opacity={0.7}
        drift="slow"
        class="desktop-only wave-layer"
      />
      <ArtLayer 
        srcDesktop={optGlow3.src} 
        positionDesktop="center right"
        positionMobile="center"
        sizeDesktop="40%"
        sizeMobile="80%"
        blendMode="screen"
        opacity={0.6}
        drift="slow"
        class="highlight-glow"
      />
      <ArtLayer 
        srcDesktop={optGlow4.src} 
        positionDesktop="bottom right"
        sizeDesktop="30%"
        blendMode="screen"
        opacity={0.5}
        drift="slow"
        class="desktop-only"
      />
      <ArtLayer 
        srcDesktop={optCube1.src} 
        positionDesktop="65% 40%"
        sizeDesktop="120px"
        blendMode="screen"
        drift="slow"
        class="desktop-only"
      />
      <ArtLayer 
        srcDesktop={optCube2.src} 
        positionDesktop="75% 60%"
        sizeDesktop="80px"
        blendMode="screen"
        drift="slow"
        class="desktop-only"
      />
      <ArtLayer 
        srcDesktop={optCube3.src} 
        positionDesktop="85% 30%"
        sizeDesktop="60px"
        blendMode="screen"
        drift="slow"
        class="desktop-only"
      />
    </div>

    <!-- Hero Content -->
    <div class="hero-content">
      <!-- Top Left Corner Text -->
      <div class="corner-text top-left reveal">
        <div class="bar"></div>
        <p>{hero.cornerTopLeft[0]}<br />{hero.cornerTopLeft[1]}</p>
      </div>

      <!-- Bottom Left Corner Text -->
      <div class="corner-text bottom-left reveal">
        <div class="bar"></div>
        <p>
          {hero.cornerBottomLeft.map((line: string) => (
            <>{line}<br /></>
          ))}
        </p>
      </div>

      <!-- Right Corner Text (Desktop Only) -->
      <div class="corner-text right-side desktop-only reveal">
        <div class="bar"></div>
        <p>
          {hero.cornerRight.map((line: string) => (
            <>{line}<br /></>
          ))}
        </p>
      </div>

      <!-- Scroll Indicator -->
      <div class="scroll-indicator reveal">
        <div class="scroll-line"></div>
        <span class="scroll-label">{hero.scrollLabel}</span>
      </div>

      <!-- Main Center Block -->
      <div class="hero-center reveal">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 class="headline">
          {hero.headlineLine1}<br />
          {hero.headlineLine2} <span class="accent">{hero.headlineAccent}</span>
        </h1>
        <p class="subline">{hero.subline}</p>
        <a href={hero.cta.href} class="btn-primary">
          {hero.cta.label} <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Page Content -->
  <div class="page-body">
    <!-- Desktop Stepper Column -->
    <aside class="stepper-column desktop-only">
      <div class="stepper-sticky">
        <Stepper steps={stepper} />
      </div>
    </aside>

    <!-- Sections Area -->
    <main class="sections">
      
      <!-- Section 01: Who We Are -->
      <section id="who-we-are" class="page-section section-who-we-are">
        <div class="mobile-only section-stepper">
          <Stepper steps={stepper} activeId="who-we-are" />
        </div>

        <div class="who-we-are-layout">
          <!-- Text Column -->
          <div class="who-we-are-content reveal">
            <Eyebrow text={whoWeAre.eyebrow} color="purple-soft" />
            <SectionHeading plain={whoWeAre.heading.plain} accent={whoWeAre.heading.accent} />
            <p class="who-we-are-body">{whoWeAre.body}</p>
            <div class="who-we-are-action">
              <TextLink href={whoWeAre.link.href} label={whoWeAre.link.label} color="purple-soft" />
            </div>
          </div>

          <!-- Section 01 Artwork -->
          <div class="who-we-are-art" aria-hidden="true">
            <ArtLayer 
              srcDesktop={optGradBlueTop.src} 
              positionDesktop="top right"
              sizeDesktop="contain"
              blendMode="screen"
              opacity={0.35}
              drift="slow"
              mask="radial-gradient(ellipse at 80% 20%, black 30%, transparent 80%)"
              class="desktop-only who-art-beam"
            />
            <ArtLayer 
              srcDesktop={optBgMiddle.src} 
              srcMobile={optBgMiddle.src}
              positionDesktop="center right"
              sizeDesktop="contain"
              positionMobile="center bottom"
              sizeMobile="contain"
              blendMode="screen"
              opacity={0.88}
              drift="slow"
              mask="radial-gradient(ellipse 85% 85% at 65% 50%, black 40%, transparent 95%)"
              class="who-art-ridge"
            />
          </div>
        </div>
      </section>

      <!-- Section 02: What We Do -->
      <section id="what-we-do" class="page-section section-what-we-do">
        <div class="mobile-only section-stepper">
          <Stepper steps={stepper} activeId="what-we-do" />
        </div>

        <div class="what-we-do-container">
          <!-- Section 02 Header -->
          <div class="what-we-do-header reveal">
            <div class="what-we-do-header-left">
              <Eyebrow text={whatWeDo.eyebrow} color="magenta-soft" />
              <SectionHeading heading={whatWeDo.heading} class="what-we-do-title" />
            </div>
            <div class="what-we-do-header-right">
              <p class="what-we-do-intro">{whatWeDo.intro}</p>
            </div>
          </div>

          <!-- Section 02 Columns / Cards -->
          <div class="what-we-do-grid reveal">
            {whatWeDo.items.map((item) => (
              <div class="what-item">
                <div class="icon-tile">
                  <Icon name={item.icon} size={24} />
                </div>
                <h3 class="what-item-title">{item.title}</h3>
                <p class="what-item-text">{item.text}</p>
                {item.href && (
                  <a href={item.href} class="mobile-only what-item-arrow" aria-label={`Learn more about ${item.title}`}>
                    <Icon name="arrow-right" size={20} />
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 03: Our Projects -->
      <section id="our-projects" class="page-section section-our-projects">
        <div class="mobile-only section-stepper">
          <Stepper steps={stepper} activeId="our-projects" />
        </div>

        <div class="projects-layout">
          <!-- Left Column (Desktop: Header + Art) -->
          <div class="projects-col-left">
            <div class="projects-header reveal">
              <Eyebrow text={projects.eyebrow} color="magenta-soft" />
              <SectionHeading heading={projects.heading} class="projects-title" />
            </div>
            <div class="projects-art" aria-hidden="true">
              <ArtLayer 
                srcDesktop={optWave3.src}
                positionDesktop="center"
                positionMobile="center"
                sizeDesktop="contain"
                sizeMobile="contain"
                blendMode="screen"
                opacity={0.7}
                drift="slow"
                mask="radial-gradient(ellipse at 50% 50%, black 50%, transparent 95%)"
                class="projects-art-wave"
              />
              <ArtLayer 
                srcDesktop={optCubeLarge.src}
                positionDesktop="center"
                positionMobile="center"
                sizeDesktop="contain"
                sizeMobile="contain"
                blendMode="screen"
                opacity={0.95}
                drift="slow"
                class="projects-art-cube"
              />
            </div>
          </div>

          <!-- Right Column (Desktop: Intro + Link + Timeline) -->
          <div class="projects-col-right">
            <div class="projects-intro-block reveal">
              <p class="projects-intro">{projects.intro}</p>
              {projects.link.href && (
                <div class="projects-action">
                  <TextLink href={projects.link.href} label={projects.link.label} color="white" />
                </div>
              )}
            </div>

            <!-- Timeline Rail -->
            <div class="projects-timeline-wrap reveal">
              <div class="timeline">
                {projects.items.length === 0 ? (
                  <div class="timeline-item timeline-empty">
                    <div class="timeline-marker" aria-hidden="true">
                      <span class="timeline-dot timeline-dot--glowing"></span>
                    </div>
                    <div class="timeline-body">
                      <div class="timeline-badge-wrap">
                        <span class="timeline-badge">{projects.emptyState.badge}</span>
                      </div>
                      <h3 class="timeline-title">{projects.emptyState.title}</h3>
                      <p class="timeline-summary">{projects.emptyState.text}</p>
                    </div>
                  </div>
                ) : (
                  projects.items.map((item: any, index: number) => {
                    const statusLabel = projects.statusLabels[item.status as keyof typeof projects.statusLabels] || item.status;
                    const isActive = item.status === 'active';
                    return (
                      <div class="timeline-item">
                        <div class="timeline-marker" aria-hidden="true">
                          <span class:list={['timeline-dot', { 'timeline-dot--glowing': isActive || index === 0 }]}></span>
                        </div>
                        <div class="timeline-body">
                          <span class={`timeline-status-label status-${item.status}`}>{statusLabel}</span>
                          <h3 class="timeline-title">{item.name}</h3>
                          <p class="timeline-summary">{item.summary}</p>
                          {isActive && (item.department || item.memberCount) && (
                            <div class="timeline-meta">
                              {item.department && <span>Dept: {item.department}</span>}
                              {item.memberCount && <span>{item.memberCount} members</span>}
                            </div>
                          )}
                          {item.link && (
                            <div class="timeline-action">
                              <TextLink href={item.link} label="View project" color="white" />
                            </div>
                          )}
                        </div>
                      </div>
                    );
                  })
                )}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 04: Ways to Engage -->
      <section id="ways-to-engage" class="page-section section-ways-to-engage">
        <div class="mobile-only section-stepper">
          <Stepper steps={stepper} activeId="ways-to-engage" />
        </div>

        <div class="ways-to-engage-container">
          <!-- Section 04 Header -->
          <div class="ways-to-engage-header reveal">
            <div class="ways-to-engage-header-left">
              <Eyebrow text={waysToEngage.eyebrow} color="magenta-soft" />
              <SectionHeading heading={waysToEngage.heading} class="ways-to-engage-title" />
            </div>
            <div class="ways-to-engage-header-right">
              <p class="ways-to-engage-intro">{waysToEngage.intro}</p>
            </div>
          </div>

          <!-- Section 04 Grid: 4 Cards -->
          <div class="ways-to-engage-grid reveal">
            {waysToEngage.cards.map((card) => (
              <div class="engage-card">
                <div class="engage-icon-tile">
                  <Icon name={card.icon} size={24} />
                </div>
                <h3 class="engage-card-title">{card.title}</h3>
                <p class="engage-card-text">{card.text}</p>
                {card.href && (
                  <div class="engage-card-action">
                    <TextLink href={card.href} label={card.linkLabel} color="magenta" />
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Section 04 Bottom Artwork -->
        <div class="ways-to-engage-art" aria-hidden="true">
          <ArtLayer 
            srcDesktop={optGroundElement.src}
            positionDesktop="bottom center"
            positionMobile="bottom center"
            sizeDesktop="contain"
            sizeMobile="contain"
            blendMode="screen"
            opacity={0.65}
            mask="linear-gradient(to top, black 25%, transparent 100%)"
            class="engage-art-ground"
          />
          <ArtLayer 
            srcDesktop={optWave1.src}
            positionDesktop="bottom left"
            positionMobile="bottom left"
            sizeDesktop="contain"
            sizeMobile="contain"
            blendMode="screen"
            opacity={0.35}
            drift="slow"
            mask="radial-gradient(ellipse at 20% 80%, black 30%, transparent 80%)"
            class="desktop-only engage-art-wave-left"
          />
          <ArtLayer 
            srcDesktop={optWave4.src}
            positionDesktop="bottom right"
            positionMobile="bottom right"
            sizeDesktop="contain"
            sizeMobile="contain"
            blendMode="screen"
            opacity={0.4}
            drift="slow"
            mask="radial-gradient(ellipse at 80% 80%, black 30%, transparent 80%)"
            class="desktop-only engage-art-wave-right"
          />
        </div>
      </section>

    </main>
  </div>
</BaseLayout>

<script>
  import { initStepper } from '../lib/stepper';
  import { initReveal } from '../lib/reveal';

  // Initialize scripts on the client
  document.addEventListener('DOMContentLoaded', () => {
    initStepper();
    initReveal();
  });
</script>

<style>
  /* Hero Styles */
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    min-height: max(640px, 100vh);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Fine-tuning some art positions */
  .wave-layer {
    transform: translateY(15%);
  }

  .highlight-glow {
    transform: translate(10%, -10%);
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 24px;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 10;
  }

  /* Center Block */
  .hero-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: -10vh; /* Shift up slightly */
  }

  .eyebrow {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .headline {
    font-family: var(--font-sans);
    font-size: var(--text-hero);
    font-weight: 300;
    line-height: 1.02;
    text-transform: uppercase;
    margin: 0 0 24px 0;
  }

  .headline .accent {
    color: var(--color-purple);
  }

  .subline {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    margin-bottom: 40px;
    max-width: 500px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-button-bg);
    color: var(--color-button-text);
    padding: 0 22px;
    height: 48px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--shadow-button);
    transition: all var(--ease);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(255,255,255,0.2);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-primary:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .arrow {
    transition: transform var(--ease);
  }

  .btn-primary:hover .arrow {
    transform: translateX(3px);
  }

  /* Corner Texts */
  .corner-text {
    position: absolute;
    font-size: var(--text-corner);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    display: flex;
    gap: 16px;
    line-height: 1.5;
  }

  .corner-text p {
    margin: 0;
  }

  .bar {
    width: 1px;
    background: var(--color-text-faint);
  }

  .top-left {
    top: max(120px, 15vh);
    left: 24px;
  }

  .bottom-left {
    bottom: 48px;
    left: 24px;
  }

  .right-side {
    top: 50%;
    right: 24px;
    transform: translateY(-50%);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 48px;
    right: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--color-text-faint), transparent);
  }

  .scroll-label {
    font-size: var(--text-corner);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-faint);
    writing-mode: vertical-rl;
  }

  /* Layout below hero */
  .page-body {
    position: relative;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 64px;
  }

  .stepper-column {
    width: 200px;
    flex-shrink: 0;
    padding-top: 120px;
  }

  .stepper-sticky {
    position: sticky;
    top: 120px; /* Offset from sticky header */
  }

  .sections {
    flex: 1;
    min-width: 0;
    padding-top: 80px;
    padding-bottom: 120px;
  }

  .page-section {
    min-height: 70vh;
    padding: 80px 0;
  }

  /* Section 01: Who We Are */
  .section-who-we-are {
    position: relative;
    padding: 80px 0 100px;
  }

  .who-we-are-layout {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .who-we-are-content {
    position: relative;
    z-index: 2;
    max-width: 100%;
  }

  .who-we-are-body {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-body);
    line-height: 1.65;
    max-width: 62ch;
  }

  .who-we-are-action {
    margin-top: var(--space-6);
  }

  .who-we-are-art {
    position: relative;
    width: 100%;
    max-width: 360px;
    height: 240px;
    margin: var(--space-6) auto 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Section 02: What We Do */
  .section-what-we-do {
    position: relative;
    padding: 80px 0 100px;
  }

  .what-we-do-container {
    position: relative;
    width: 100%;
  }

  .what-we-do-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
    position: relative;
    z-index: 2;
  }

  .what-we-do-title {
    max-width: 520px;
  }

  .what-we-do-intro {
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 100%;
  }

  .what-we-do-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
    z-index: 2;
  }

  .what-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
  }

  .icon-tile {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-icon-tile);
    background: var(--color-icon-tile);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
  }

  .what-item-title {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }

  .what-item-text {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .what-item-arrow {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    margin-top: auto;
    padding-top: var(--space-2);
    transition: transform var(--ease-hover) var(--ease), color var(--ease-hover) var(--ease);
  }

  .what-item-arrow:hover {
    transform: translateX(4px);
    color: var(--color-purple-soft);
  }

  .what-item-arrow:focus-visible {
    outline: 2px solid #ffffff;
