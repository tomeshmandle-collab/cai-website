---
import { Image } from 'astro:assets';
import { getSiteContent } from '../../lib/content';
import { getCopyrightYear } from '../../lib/counts';
import { resolveBrandLogo } from '../../lib/images';

const site = await getSiteContent();
const currentYear = getCopyrightYear();
const logoImage = await resolveBrandLogo(site.brand.logo, false);
const affiliationLogoImage = await resolveBrandLogo(site.footer.affiliation.logo, true);

// Filter socials where url is non-empty
const activeSocials = site.footer.socials.filter(s => s.url && s.url.trim() !== '');
---

<footer class="site-footer">
  <div class="footer-inner container">
    <!-- Top 4 Columns (Desktop) / Ordered Blocks (Mobile) -->
    <div class="footer-columns">
      <!-- Col 1: Brand & Tagline & Socials -->
      <div class="footer-col col-brand">
        <a href="/" class="brand-link" aria-label={site.brand.name}>
          <div class="logo-slot">
            <Image src={logoImage} alt="" width={44} height={44} class="logo-img" />
          </div>
          {site.brand.showWordmark && (
            <span class="wordmark">
              <span>Centre for</span>
              <span>Artificial Intelligence</span>
            </span>
          )}
        </a>

        <p class="tagline">{site.brand.tagline}</p>

        {activeSocials.length > 0 && (
          <div class="socials-row">
            {activeSocials.map(social => (
              <a
                href={social.url}
                class="social-icon-btn"
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                {social.platform === 'linkedin' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                    <rect x="2" y="9" width="4" height="12"/>
                    <circle cx="4" cy="4" r="2"/>
                  </svg>
                )}
                {social.platform === 'instagram' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                )}
                {social.platform === 'x' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 4l16 16M4 20L20 4"/>
                  </svg>
                )}
                {social.platform === 'youtube' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
                    <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
                  </svg>
                )}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Col 2: Navigate -->
      <div class="footer-col col-navigate">
        <h3 class="col-title">{site.footer.navigateTitle}</h3>
        <ul class="navigate-list">
          {site.footer.navigate.map(navItem => {
            const isMore = navItem.label.toLowerCase() === 'more';
            return (
              <li class="navigate-item">
                <a href={navItem.href} class="navigate-link" aria-label={isMore ? "Contact CAI" : undefined} title={isMore ? "Contact CAI" : undefined}>
                  <span>{navItem.label}</span>
                  <svg
                    class:list={['nav-arrow', { 'nav-arrow--always': isMore }]}
                    width="12"
                    height="12"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Col 3: Get in Touch -->
      <div class="footer-col col-contact">
        <h3 class="col-title">{site.footer.contactTitle}</h3>
        <ul class="contact-list">
          {site.footer.email && (
            <li class="contact-item">
              <a href={`mailto:${site.footer.email}`} class="contact-link">
                <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                <span>{site.footer.email}</span>
              </a>
            </li>
          )}
          {site.footer.phone && (
            <li class="contact-item">
              <a href={`tel:${site.footer.phone.replace(/\s+/g, '')}`} class="contact-link">
                <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>{site.footer.phone}</span>
              </a>
            </li>
          )}
          {site.footer.addressLines && site.footer.addressLines.length > 0 && (
            <li class="contact-item contact-item--address">
              <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <div class="address-text">
                {site.footer.addressLines.map(line => (
                  <div>{line}</div>
                ))}
              </div>
            </li>
          )}
        </ul>
      </div>

      <!-- Col 4: Our Affiliation -->
      <div class="footer-col col-affiliation">
        <h3 class="col-title">{site.footer.affiliationTitle}</h3>
        <div class="affiliation-content">
          <div class="affiliation-logo-slot">
            <Image src={affiliationLogoImage} alt="" width={56} height={56} class="affiliation-logo-img" />
          </div>
          <div class="affiliation-details">
            <div class="affiliation-name">{site.footer.affiliation.name}</div>
            <div class="affiliation-sub">{site.footer.affiliation.line1}</div>
            <div class="affiliation-sub">{site.footer.affiliation.line2}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal -->
    <div class="footer-bottom">
      <div class="copyright">
        &copy; {currentYear} {site.footer.copyrightText}
      </div>
      <div class="legal-links">
        {site.footer.legal.map((item, index) => (
          <>
            <a href={item.href} class="legal-link">{item.label}</a>
            {index < site.footer.legal.length - 1 && <span class="legal-divider">|</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
    color: var(--color-text-muted);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
  }

  .footer-columns {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  @media (min-width: 1024px) {
    .footer-columns {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1.2fr 1.4fr;
      gap: var(--space-6);
    }

    .footer-col {
      padding-right: var(--space-4);
      border-right: 1px solid var(--color-border);
    }

    .footer-col:last-child {
      border-right: none;
      padding-right: 0;
    }
  }

  /* Col 1 Brand */
  .col-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
  }

  .logo-slot {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: var(--radius-pill);
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .tagline {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .socials-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .social-icon-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    transition: border-color var(--ease-hover) var(--ease),
                color var(--ease-hover) var(--ease),
                background-color var(--ease-hover) var(--ease);
  }

  .social-icon-btn:hover {
    border-color: var(--color-border-strong);
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  /* Titles */
  .col-title {
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }

  /* Col 2 Navigate */
  .navigate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .navigate-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--ease-hover) var(--ease);
  }

  .navigate-link:hover {
    color: var(--color-text);
  }

  .nav-arrow {
    display: inline-block;
    transition: transform var(--ease-hover) var(--ease);
    color: var(--color-text-faint);
  }

  .navigate-link:hover .nav-arrow {
    transform: translateX(3px);
    color: var(--color-text);
  }

  @media (min-width: 1024px) {
    .nav-arrow {
      display: none;
    }
    .nav-arrow--always {
      display: inline-block;
    }
    .navigate-link {
      justify-content: flex-start;
      gap: var(--space-2);
    }
  }

  /* Col 3 Contact */
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-item {
    font-size: var(--text-small);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--ease-hover) var(--ease);
  }

  .contact-link:hover {
    color: var(--color-text);
  }

  .contact-item--address {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-text-muted);
  }

  .contact-icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-text-muted);
  }

  .address-text {
    line-height: 1.5;
  }

  /* Col 4 Affiliation */
  .affiliation-content {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .affiliation-logo-slot {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .affiliation-logo-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .affiliation-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .affiliation-name {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.3;
  }

  .affiliation-sub {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  /* Bottom Row */
  .footer-bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-faint);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .legal-link {
    color: var(--color-text-faint);
    text-decoration: none;
    transition: color var(--ease-hover) var(--ease);
  }

  .legal-link:hover {
    color: var(--color-text);
  }

  .legal-divider {
    color: var(--color-border);
  }
</style>
