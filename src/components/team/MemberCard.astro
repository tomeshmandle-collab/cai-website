---
import { resolvePhoto } from '../../lib/images';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  role: string;
  functionName: string;
  photo?: string;
  focus?: string;
  link?: string;
}

const { name, role, functionName, photo, focus = 'center', link } = Astro.props;

// photo could be a filename. resolvePhoto returns an ImageMetadata or string (for placeholder svg).
// Wait, resolvePhoto returns an import of ImageMetadata. 
const resolvedImg = await resolvePhoto(photo);

const Wrapper = link ? 'a' : 'div';
const wrapperProps = link ? { href: link, class: 'member-card has-link' } : { class: 'member-card' };

// Since resolvedImg could be ImageMetadata from astro:assets or a string from import
const isSVG = typeof resolvedImg === 'string';
---

<Wrapper {...wrapperProps}>
  <div class="card-image-wrap">
    {isSVG ? (
      <img src={resolvedImg} alt={`Portrait of ${name}, ${role}`} class="card-image" style={`object-position: ${focus}`} loading="lazy" />
    ) : (
      <Image 
        src={resolvedImg} 
        alt={`Portrait of ${name}, ${role}`} 
        class="card-image" 
        style={`object-position: ${focus}`}
        width={400}
        loading="lazy"
      />
    )}
    <div class="card-gradient" aria-hidden="true"></div>
  </div>

  <div class="card-text">
    <h3 class="member-name">{name}</h3>
    <p class="member-role">{role}</p>
    <p class="member-function">{functionName}</p>
  </div>
  
  {link && (
    <div class="card-arrow" aria-hidden="true">
      <span class="arrow-icon">→</span>
    </div>
  )}
</Wrapper>

<style>
  .member-card {
    display: block;
    position: relative;
    /* Fixed card size on desktop, adjustable on mobile via variables if needed */
    width: var(--card-width, 200px);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: all var(--ease);
    flex-shrink: 0;
  }

  .member-card.has-link:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.5);
  }

  .card-image-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform var(--ease);
  }

  .member-card.has-link:hover .card-image {
    transform: scale(1.03);
  }

  /* Dark gradient rising from the bottom */
  .card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.7) 25%,
      rgba(0, 0, 0, 0) 60%
    );
    pointer-events: none;
  }

  .card-text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 2;
  }

  .member-name {
    font-size: 14px;
    font-weight: 500;
    color: white;
    margin: 0 0 2px 0;
    line-height: 1.3;
  }
  
  @media (min-width: 768px) {
    .member-name {
      font-size: 15px;
    }
  }

  .member-role {
    font-size: 12px;
    color: var(--color-magenta);
    margin: 0;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .member-role {
      font-size: 13px;
    }
  }

  .member-function {
    font-size: 11px;
    color: var(--color-text-faint);
    margin: 0;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .member-function {
      font-size: 12px;
    }
  }

  .card-arrow {
    position: absolute;
    bottom: 20px;
    right: 20px;
    color: white;
    font-size: 16px;
    z-index: 2;
    transition: transform var(--ease);
  }

  .member-card.has-link:hover .card-arrow {
    transform: translateX(3px);
  }
</style>
