---
import Icon from '../ui/Icon.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  href?: string;
}

const { icon, title, description, href } = Astro.props;

const Wrapper = href ? 'a' : 'div';
const wrapperProps = href ? { href, class: 'function-card has-link' } : { class: 'function-card' };
---

<Wrapper {...wrapperProps}>
  <div class="card-icon" aria-hidden="true">
    <Icon name={icon} />
  </div>
  <div class="card-content">
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
  </div>
  {href && (
    <div class="card-arrow mobile-only" aria-hidden="true">
      <span class="arrow-icon">→</span>
    </div>
  )}
</Wrapper>

<style>
  .function-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
    gap: 16px;
    text-decoration: none;
    transition: all var(--ease);
    height: 100%;
    position: relative;
  }

  .function-card.has-link:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .card-icon {
    width: 32px;
    height: 32px;
    color: white;
  }

  .card-icon :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-title {
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
  }

  .card-desc {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .card-arrow {
    position: absolute;
    bottom: 24px;
    right: 24px;
    color: var(--color-magenta);
    font-size: 16px;
    display: none;
  }

  @media (max-width: 767px) {
    .function-card {
      padding: 22px;
    }
    
    .card-arrow {
      display: block;
    }
    
    .function-card.has-link {
      padding-bottom: 48px; /* space for arrow */
    }
  }
</style>
